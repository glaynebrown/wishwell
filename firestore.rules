rules_version = '2';

// Wishwell. The important promises:
//   * You can see someone's list only if you're linked to them (personal code)
//     or share a family group with them.
//   * Claims ("I'll get this") are visible to everyone who can see the list --
//     EXCEPT the person whose list it is.
//   * Gift ideas others add are visible only inside the circle they were added
//     in (a family group), or only to the person who added them.
//     Never to the person they're for.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function me() { return request.auth.uid; }
    function pairId(a, b) { return a < b ? a + '_' + b : b + '_' + a; }
    function groupsOf(uid) {
      return get(/databases/$(database)/documents/users/$(uid)).data.get('groups', []);
    }
    function linked(owner) {
      return exists(/databases/$(database)/documents/links/$(pairId(me(), owner)));
    }
    function canSee(owner) {
      return signedIn() && me() != owner && (linked(owner) || groupsOf(me()).hasAny(groupsOf(owner)));
    }
    function inSharedGroup(owner, scope) {
      return scope in groupsOf(me()) && scope in groupsOf(owner);
    }

    match /users/{uid} {
      allow read: if signedIn() && (me() == uid || canSee(uid));
      allow create, update, delete: if signedIn() && me() == uid;

      match /private/{doc} {
        allow read, write: if signedIn() && me() == uid;
      }

      match /items/{id} {
        allow read: if signedIn() && (me() == uid || canSee(uid));
        allow create: if signedIn() && me() == uid;
        allow update: if signedIn() && (
          me() == uid
          // a giver handing over one of several (qty goes down by one)
          || (canSee(uid)
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['qty'])
              && resource.data.qty > 1
              && request.resource.data.qty == resource.data.qty - 1)
        );
        allow delete: if signedIn() && (
          me() == uid
          // a giver handing it over: it must land in Received in the same write
          || (canSee(uid) && existsAfter(/databases/$(database)/documents/users/$(uid)/received/$(id)))
        );
      }

      match /claims/{id} {
        allow read: if signedIn() && (canSee(uid) || resource.data.by == me());
        allow create: if canSee(uid)
          && request.resource.data.by == me()
          && id == request.resource.data.ref + '_' + me();
        allow update: if canSee(uid) && resource.data.by == me() && request.resource.data.by == me();
        allow delete: if signedIn() && resource.data.by == me();
      }

      // Gift ideas live in a folder per circle: a family group code (members
      // of that group who aren't the owner) or 'u_' + the adder (just them).
      match /circles/{circle}/ideas/{id} {
        function inCircle() {
          return canSee(uid) && (circle == 'u_' + me() || inSharedGroup(uid, circle));
        }
        allow read, delete: if signedIn() && inCircle();
        allow create: if signedIn() && inCircle() && request.resource.data.by == me();
        allow update: if signedIn() && inCircle() && request.resource.data.by == resource.data.by;
      }

      match /received/{id} {
        allow read, update, delete: if signedIn() && me() == uid;
        allow create: if signedIn() && (me() == uid || (canSee(uid) && request.resource.data.fromUid == me()));
      }
    }

    match /codes/{code} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn() && (
        (request.resource.data.type == 'person' && request.resource.data.uid == me())
        || (request.resource.data.type == 'group'
            && me() in getAfter(/databases/$(database)/documents/groups/$(code)).data.members)
      );
      allow update: if false;
      allow delete: if signedIn() && (
        (resource.data.type == 'person' && resource.data.uid == me())
        || (resource.data.type == 'group' && !existsAfter(/databases/$(database)/documents/groups/$(code)))
      );
    }

    // A family group's id IS its code, so knowing the code is what lets you join.
    match /groups/{code} {
      allow read: if signedIn() && me() in resource.data.members;
      allow create: if signedIn() && request.resource.data.members == [me()];
      allow update: if signedIn() && (
        // members can rename it
        (me() in resource.data.members
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name']))
        // join: add only yourself
        || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members'])
          && request.resource.data.members.toSet() == resource.data.members.toSet().union([me()].toSet())
          && request.resource.data.members.size() == resource.data.members.size() + 1)
        // leave: remove only yourself
        || (me() in resource.data.members
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members'])
          && request.resource.data.members.toSet() == resource.data.members.toSet().difference([me()].toSet()))
      );
      allow delete: if signedIn() && resource.data.members == [me()];
    }

    // One-to-one links. Making one takes the other person's personal code.
    match /links/{id} {
      allow read: if signedIn() && me() in resource.data.users;
      allow create: if signedIn()
        && request.resource.data.users.size() == 2
        && me() in request.resource.data.users
        && id == pairId(request.resource.data.users[0], request.resource.data.users[1])
        && get(/databases/$(database)/documents/codes/$(request.resource.data.code)).data.uid
           == (request.resource.data.users[0] == me() ? request.resource.data.users[1] : request.resource.data.users[0]);
      allow update: if false;
      allow delete: if signedIn() && me() in resource.data.users;
    }
  }
}
